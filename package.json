{
  "name": "home-management-center",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "bun run routes:generate && rsbuild build",
    "build:embedded": "bun run routes:generate && rsbuild build && node scripts/write-panel-manifest.mjs",
    "preview": "rsbuild preview",
    "routes:generate": "tsr generate",
    "typecheck": "bun run routes:generate && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.0.0",
    "@radix-ui/react-slot": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-table": "^8.0.0",
    "@tanstack/react-virtual": "^3.0.0",
    "axios": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "cmdk": "^1.0.0",
    "i18next": "^25.0.0",
    "input-otp": "^1.0.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.0.0",
    "next-themes": "^0.4.0",
    "qrcode.react": "^4.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-i18next": "^16.0.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "vaul": "^1.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@rsbuild/core": "^2.0.0",
    "@rsbuild/plugin-react": "^2.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/router-cli": "^1.0.0",
    "@tanstack/router-plugin": "^1.0.0",
    "@trivago/prettier-plugin-sort-imports": "^5.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "happy-dom": "^21.0.3",
    "knip": "^5.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}

{
  "entry": [
    "src/main.tsx",
    "src/entries/*.tsx",
    "src/routes/**/*.tsx",
    "tests/**/*.{ts,tsx}",
    "scripts/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "scripts/*.mjs", "*.{ts,js,mjs,json}"],
  "ignore": ["src/env.d.ts"],
  "ignoreIssues": {
    "src/components/ui/button.tsx": ["exports"],
    "src/components/ui/dropdown-menu.tsx": ["exports"],
    "src/components/ui/sheet.tsx": ["exports"],
    "src/components/ui/sidebar.tsx": ["exports"]
  },
  "ignoreDependencies": [
    "@radix-ui/react-slot",
    "@hookform/resolvers",
    "@tanstack/react-table",
    "@tanstack/react-virtual",
    "input-otp",
    "motion",
    "react-hook-form",
    "recharts",
    "tw-animate-css",
    "vaul"
  ]
}
